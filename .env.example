# ─────────────────────────────────────────────────────────────────────────────
# AgriNASA environment template
#
# Copy this file to `.env` in the project root and edit only what you need:
#     cp .env.example .env
#
# This file must NEVER contain real secrets. Leave keys empty unless you are
# configuring them locally, and never commit your `.env` file to git.
# All AI calls happen in the backend; the browser never receives these values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# development | test | production
ENVIRONMENT=development

# live  = call NASA POWER over the network
# demo  = replay the cached Qena snapshot (works fully offline)
DATA_MODE=demo

# SQLite by default. The path is relative to where the backend is started unless
# you provide an absolute path. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agrinasa
DATABASE_URL=sqlite:///data/agrinasa.db

# Comma-separated browser origins allowed by CORS (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── NASA POWER (no API key required) ─────────────────────────────────────────
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
NASA_TIMEOUT_SECONDS=30
NASA_CACHE_TTL_SECONDS=21600
# Maximum length of a single environment request; longer ranges are clamped.
NASA_MAX_SERIES_DAYS=366

# ── Geocoding proxy (OpenStreetMap Nominatim) ────────────────────────────────
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=AgriNASA/1.0 (student educational project)
GEOCODING_TIMEOUT_SECONDS=10

# ── Weather forecast (Open-Meteo, no API key required) ───────────────────────
# NASA POWER has no forecast product, so the farmer guide asks Open-Meteo for a
# short daily outlook. When it is unreachable the forecast is reported as
# unavailable; no values are invented.
FORECAST_BASE_URL=https://api.open-meteo.com/v1
FORECAST_TIMEOUT_SECONDS=10

# ── AI assistant (optional, OpenAI-compatible endpoint) ──────────────────────
# Leave AI_API_KEY empty to use the deterministic rule-based explainer.
# The key is read by the backend only and is never exposed to the frontend.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_REQUESTS_PER_HOUR=30

# ── Fale7 AI / RAYAN assistant (optional, Google Gemini) ─────────────────────
# All keys are optional. The simplest path is to add the key in the app's
# "Fale7 AI" settings screen; it is stored encrypted in the backend and never
# sent to the browser. The variables below bootstrap a fresh installation or
# protect key management in a deployment.
# Get a key from https://aistudio.google.com/apikey (free tier available).
# RAYAN_GEMINI_API_KEY=
# RAYAN_GEMINI_MODEL=gemini-2.0-flash
# Fernet key; when absent a keyfile is generated under backend/secrets/.
# RAYAN_ENCRYPTION_KEY=
# Require this token in the RAYAN_SETTINGS_TOKEN header for remote key changes.
# RAYAN_SETTINGS_TOKEN=
RAYAN_MAX_REQUESTS_PER_HOUR=20

# ── Open-Meteo history + current conditions (no API key required) ────────────
# The Explore Map, Location Analysis and Crop Intelligence pages read the ERA5 /
# ERA5-Land archive (1940 → a few days behind real time) and the latest current
# conditions from Open-Meteo. No registration is needed. When unreachable the
# response says so; no values are invented.
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1
OPEN_METEO_TIMEOUT_SECONDS=25
# Long-term baseline years for the historical comparisons (inclusive).
CLIMATE_BASELINE_START=1991
CLIMATE_BASELINE_END=2020
HISTORY_DEFAULT_YEARS=5

# ── ISRIC SoilGrids (modelled soil properties, no API key required) ──────────
# 250 m machine-learning product (pH, SOC, clay/sand/silt, CEC, nitrogen).
# Earth Engine hosts the official ISRIC assets and is tried first when GEE is
# configured; this REST endpoint is the keyless fallback (cached 30 days).
# SoilGrids is a model, not a laboratory soil test.
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0
SOILGRIDS_TIMEOUT_SECONDS=90

# ── Explore / history response cache ─────────────────────────────────────────
# On-disk JSON cache so repeated map clicks do not hammer public APIs.
# EXPLORE_CACHE_DIR=backend/data/cache
EXPLORE_CACHE_TTL_SECONDS=1800
HISTORY_CACHE_TTL_SECONDS=43200

# ── FAO WaPOR (optional, free registration required) ─────────────────────────
# Water productivity / actual evapotranspiration layers. Register at
# https://data.apps.fao.org/wapor, create a personal token and paste it here.
# Leave empty: WaPOR is reported as "not configured" and the app uses the
# Open-Meteo / NASA POWER water balance instead.
WAPOR_TOKEN=
WAPOR_TIMEOUT_SECONDS=25

# ── Google Earth Engine (optional satellite analysis + NDVI) ────────────────
# Enables Sentinel-1 surface wetness and Sentinel-2 NDVI/NDMI on the Satellite
# tab, the NDVI card in Crop health, SoilGrids assets, SMAP soil moisture,
# Dynamic World land cover and GPM IMERG rainfall on the location pages. No
# separate Earthdata/AppEEARS provider is needed. Leave these empty to keep the
# feature disabled; the API then returns a clear GEE_UNAVAILABLE message instead
# of inventing data.
# 1. Create a Google Cloud project and register it for Earth Engine.
# 2. Create a service account and download its JSON key.
# 3. Share the Earth Engine assets/registration with the service-account email.
# Credentials stay in the backend; the browser never receives them.
GEE_SERVICE_ACCOUNT=
GEE_PROJECT=
# Path to the service-account JSON key (relative to the project root).
GEE_PRIVATE_KEY_FILE=
# Alternative: the full JSON key on one line, e.g. from a secret manager.
GEE_PRIVATE_KEY_JSON=
GEE_CACHE_TTL_SECONDS=1800
GEE_MAX_DATE_RANGE_DAYS=90

# ── Demo snapshot (optional override) ────────────────────────────────────────
# DEMO_SNAPSHOT_PATH=backend/app/demo/qena_power_snapshot.json

# ── Frontend (optional, Vite) ────────────────────────────────────────────────
# In development the Vite proxy already forwards /api to the backend, so this
# normally stays unset. Set it only when the frontend is hosted separately.
# VITE_API_BASE_URL=/api
